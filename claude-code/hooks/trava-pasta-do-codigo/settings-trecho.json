{
  "permissions": {
    "deny": [
      "Edit(//caminho/absoluto/da/pasta/do/codigo/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/caminho/absoluto/.claude/hooks/trava-codigo.mjs\" \"/caminho/absoluto/da/pasta/do/codigo\"",
            "timeout": 10,
            "statusMessage": "Conferindo a trava da pasta do código"
          }
        ]
      }
    ]
  }
}
